<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — NamelyzeEcom</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Analytics (Global site tag) - GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

    <!-- Facebook Pixel Code -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', 'XXXXXXXXXXXXXXX');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=XXXXXXXXXXXXXXX&ev=PageView&noscript=1"/></noscript>

    <link rel="stylesheet" href="/css/site.css">
    @RenderSection("Styles", required: false)
</head>

<body>
    <!-- Topbar -->
    <div class="ticker-bar">
        <div class="ticker-track">
            &nbsp;&nbsp;&nbsp;&nbsp;💥 ক্যাশ অন ডেলিভারিতে অর্ডার করুন &nbsp;|&nbsp; 🚚 সারাদেশে ডেলিভারি &nbsp;|&nbsp; 📞 কল: 01804193796 &nbsp;&nbsp;&nbsp;&nbsp;
        </div>
    </div>

    <!-- Header -->
    <header class="site-header">
        <div class="container">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    <a href="/" class="navbar-brand d-flex align-items-center">
                        <div class="bg-primary rounded-3 p-1 me-2"><i class="fas fa-shopping-bag text-white fs-4"></i></div>
                        <span class="fw-bold fs-4 text-dark mb-0">Namelyze<span class="text-primary">Ecom</span></span>
                    </a>
                </div>
                <div class="col mx-md-4">
                    <div class="search-wrapper shadow-sm">
                        <input type="text" id="searchInput" placeholder="Search for products, categories...">
                        <button type="button" id="searchBtn">SEARCH</button>
                    </div>
                </div>
                <div class="col-auto d-flex align-items-center gap-3">
                    <a href="/Track" class="header-icon-box d-none d-lg-flex">
                        <i class="bi bi-truck"></i>
                        <span>Track Order</span>
                    </a>

                    <div class="vr mx-1 opacity-10 d-none d-lg-block"></div>
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <div class="header-icon-box position-relative" onclick="window.location='/Account/Profile'">
                            <i class="bi bi-person-circle"></i>
                            <span>Profile</span>
                        </div>
                    }
                    else
                    {
                        <div class="header-icon-box" onclick="window.location='/Account/Login'">
                            <i class="bi bi-person"></i>
                            <span>Login</span>
                        </div>
                    }
                    <div class="header-icon-box position-relative">
                        <i class="bi bi-cart3"></i>
                        <span class="badge-count">0</span>
                        <span>Cart</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Navigation -->
    <nav class="main-nav d-none d-md-block shadow-sm">
        <div class="container">
            <div class="nav-container">
                <button class="cat-toggle-btn">
                    <i class="fas fa-bars"></i> ALL CATEGORIES
                </button>
                <ul class="nav-links ms-3">
                    <li class="active"><a href="/">Home</a></li>
                    <li><a href="/Shop">New Arrivals</a></li>
                    <li><a href="/Shop?featured=true">Featured</a></li>
                    <li><a href="/Shop?cat=1">Home Appliances</a></li>
                    <li><a href="/Shop?cat=2">Gadgets</a></li>
                    <li><a href="/Contact">Contact Us</a></li>
                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container pb-4">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h4 class="footer-title">About NamelyzeEcom</h4>
                    <p class="small opacity-75">We provide the best quality products at your doorstep. Shop with confidence and enjoy our premium services.</p>
                    <div class="footer-socials mt-3">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>
                <div class="col-lg-2">
                    <h4 class="footer-title">Information</h4>
                    <ul class="p-0">
                        <li><a href="#">About Us</a></li>
                        <li><a href="#">Contact Us</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h4 class="footer-title">Customer Service</h4>
                    <ul class="p-0">
                        <li><a href="/OrderTracking">Track Order</a></li>
                        <li><a href="#">Return Policy</a></li>
                        <li><a href="#">Shipping Details</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h4 class="footer-title">Contact Info</h4>
                    <div class="contact-line"><i class="fas fa-phone-alt"></i> 01804193796</div>
                    <div class="contact-line"><i class="fas fa-envelope"></i> info@namelyzeecom.com</div>
                    <div class="contact-line"><i class="fas fa-map-marker-alt"></i> Dhaka, Bangladesh</div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            &copy; 2026 NamelyzeEcom | All Rights Reserved
        </div>
    </footer>


    <!-- Floating WhatsApp Button -->
    <a href="https://wa.me/8801804193796" class="whatsapp-float shadow-lg" target="_blank" title="Order via WhatsApp">
        <i class="fab fa-whatsapp"></i>
        <span class="d-none d-md-inline ms-2">Order via WhatsApp</span>
    </a>

    <!-- Scroll to Top -->
    <button class="scroll-top" id="scrollTopBtn"><i class="fas fa-chevron-up"></i></button>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/site.js"></script>
    <script src="/js/cart.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

