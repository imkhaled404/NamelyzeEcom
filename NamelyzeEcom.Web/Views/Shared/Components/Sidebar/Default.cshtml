@model IEnumerable<NamelyzeEcom.Business.DTOs.MenuDto>

<div class="sb-brand">
    <div class="sb-logo"><i class="fas fa-shopping-bag"></i></div>
    <div class="sb-title">NamelyzeEcom <small>Admin Panel</small></div>
</div>

<div class="sb-section">Navigation</div>
<ul class="sb-menu">
    @foreach (var menu in Model)
    {
        <li class="@(Context.Request.Path.Value?.Contains(menu.Url) == true ? "active" : "")">
            <a href="@menu.Url">
                <span class="sb-icon"><i class="bi @menu.Icon"></i></span> @menu.Title
            </a>
            @if (menu.SubMenus.Any())
            {
                <ul class="sb-submenu">
                    @foreach (var sub in menu.SubMenus)
                    {
                        <li><a href="@sub.Url">@sub.Title</a></li>
                    }
                </ul>
            }
        </li>
    }
</ul>

<div class="sb-footer">
    <div class="sb-user">
        <div class="av">@User.Identity?.Name?[0]</div>
        <div>
            <div class="name">@User.Identity?.Name</div>
            <div class="role">Administrator</div>
        </div>
        <a href="/Account/Logout" class="ms-auto" title="Logout" style="color:rgba(255,255,255,.4);font-size:14px;">
            <i class="fas fa-sign-out-alt"></i>
        </a>
    </div>
</div>
