@model NamelyzeEcom.Business.DTOs.UserProfileDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Profile";
}

<div class="container py-5 mt-5">
    <div class="row">
        <!-- Sidebar Navigation -->
        <div class="col-md-3 mb-4">
            <div class="p-4 rounded-4 shadow-lg bg-glass text-white h-100">
                <div class="text-center mb-4">
                    <div class="avatar-lg bg-primary bg-opacity-20 rounded-circle d-inline-flex align-items-center justify-content-center text-primary mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-person-fill fs-1"></i>
                    </div>
                    <h5 class="fw-bold mb-1">@Model.User.FirstName @Model.User.LastName</h5>
                    <p class="text-light small opacity-75">Customer</p>
                </div>
                <div class="nav flex-column nav-pills" id="profile-tabs" role="tablist">
                    <button class="nav-link active text-white text-start mb-2 px-3 py-2 rounded-3 border-0 bg-transparent" data-bs-toggle="pill" data-bs-target="#tab-info">
                        <i class="bi bi-person me-2"></i>Personal Info
                    </button>
                    <button class="nav-link text-white text-start mb-2 px-3 py-2 rounded-3 border-0 bg-transparent" data-bs-toggle="pill" data-bs-target="#tab-orders">
                        <i class="bi bi-bag-check me-2"></i>My Orders
                    </button>
                    <button class="nav-link text-white text-start mb-2 px-3 py-2 rounded-3 border-0 bg-transparent" data-bs-toggle="pill" data-bs-target="#tab-addresses">
                        <i class="bi bi-geo-alt me-2"></i>Delivery Addresses
                    </button>
                    <button class="nav-link text-white text-start mb-2 px-3 py-2 rounded-3 border-0 bg-transparent" data-bs-toggle="pill" data-bs-target="#tab-loyalty">
                        <i class="bi bi-star me-2"></i>Loyalty Points
                    </button>
                    <hr class="my-3 opacity-25">
                    <a href="/Account/Logout" class="nav-link text-danger text-start px-3 py-2 rounded-3 border-0 bg-transparent">
                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-md-9">
            <div class="tab-content">
                <!-- Personal Info Tab -->
                <div class="tab-pane fade show active" id="tab-info">
                    <div class="p-5 rounded-4 shadow-lg bg-glass text-white">
                        <h4 class="fw-bold mb-4">Personal Information</h4>
                        <form id="profileForm">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-light opacity-75 small uppercase">First Name</label>
                                    <input type="text" class="form-control bg-dark bg-opacity-25 border-light border-opacity-25 text-white p-3 rounded-3" value="@Model.User.FirstName">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-light opacity-75 small uppercase">Last Name</label>
                                    <input type="text" class="form-control bg-dark bg-opacity-25 border-light border-opacity-25 text-white p-3 rounded-3" value="@Model.User.LastName">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-light opacity-75 small uppercase">Email Address</label>
                                    <input type="email" class="form-control bg-dark bg-opacity-25 border-light border-opacity-25 text-white p-3 rounded-3" value="@Model.User.Email" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-light opacity-75 small uppercase">Phone Number</label>
                                    <input type="tel" class="form-control bg-dark bg-opacity-25 border-light border-opacity-25 text-white p-3 rounded-3" value="@Model.User.PhoneNumber">
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5">Save Changes</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Multiple Address Tab -->
                <div class="tab-pane fade" id="tab-addresses">
                    <div class="p-5 rounded-4 shadow-lg bg-glass text-white">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="fw-bold mb-0">Delivery Addresses</h4>
                            <button class="btn btn-sm btn-outline-light rounded-pill px-3"><i class="bi bi-plus-lg me-2"></i>Add New</button>
                        </div>
                        <div class="row g-4">
                            @if (!Model.Addresses.Any())
                            {
                                <div class="col-12 text-center py-5 opacity-50">
                                    <i class="bi bi-geo-alt fs-1 mb-3 d-block"></i>
                                    <p>No addresses found. Add up to 4 delivery addresses.</p>
                                </div>
                            }
                            @foreach (var addr in Model.Addresses)
                            {
                                <div class="col-md-6">
                                    <div class="p-3 rounded-3 border border-light border-opacity-25 bg-white bg-opacity-5">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="fw-bold mb-0">@addr.Label</h6>
                                            @if (addr.IsDefault) { <span class="badge bg-primary rounded-pill">Default</span> }
                                        </div>
                                        <p class="small text-light opacity-75 mb-0">@addr.AddressLine1, @addr.City</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Loyalty Tab -->
                <div class="tab-pane fade" id="tab-loyalty">
                    <div class="p-5 rounded-4 shadow-lg bg-glass text-white text-center">
                        <div class="mb-4">
                            <i class="bi bi-stars text-warning" style="font-size: 5rem;"></i>
                        </div>
                        <h2 class="display-4 fw-bold">@Model.LoyaltyPoints</h2>
                        <p class="lead text-light opacity-75 uppercase tracking-widest">Namelyze Loyalty Points</p>
                        <p class="small text-info">You can redeem these points for discounts on your next purchase!</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-glass {
        background: rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .nav-pills .nav-link.active {
        background-color: var(--bs-primary) !important;
        box-shadow: 0 4px 15px rgba(var(--bs-primary-rgb), 0.3);
    }
    
    .nav-pills .nav-link:hover:not(.active) {
        background-color: rgba(255, 255, 255, 0.1) !important;
    }
    
    .uppercase { text-transform: uppercase; }
    .tracking-widest { letter-spacing: 0.1em; }
</style>
