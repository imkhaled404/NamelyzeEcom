@{
    ViewData["Title"] = "পণ্য বিস্তারিত";
    Layout = "_Layout";
}

<div class="container py-5">
    <div id="productDetailContainer">
        <!-- Loader -->
        <div class="text-center p-5">
            <div class="spinner-border text-primary"></div>
        </div>
    </div>

    <!-- Recommendations Section -->
    <div class="mt-5 pt-5 border-top">
        @await Component.InvokeAsync("RecommendedProducts", new { limit = 4 })
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function() {
    var slug = window.location.pathname.split('/').pop();
    
    $.get('/api/products/slug/' + slug, function(res) {
        var p = res.data || res;
        var container = $('#productDetailContainer');
        container.empty().append(`
            <div class="row g-5">
                <div class="col-md-6">
                    <div class="rounded-4 overflow-hidden border shadow-sm">
                        <img src="${p.mainImageUrl || 'https://placehold.co/800'}" class="img-fluid w-100 h-100 object-fit-cover">
                    </div>
                </div>
                <div class="col-md-6">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active">${p.categoryName}</li>
                        </ol>
                    </nav>
                    <h1 class="fw-bold mb-3">${p.name}</h1>
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <h2 class="text-primary fw-bold mb-0">৳ ${p.salePrice}</h2>
                        ${p.regularPrice > p.salePrice ? `<h4 class="text-muted text-decoration-line-through mb-0">৳ ${p.regularPrice}</h4>` : ''}
                    </div>
                    <p class="text-muted mb-4">${p.shortDescription || 'No description available for this premium product.'}</p>
                    
                    <div class="d-flex gap-3 mb-5">
                        <button class="btn btn-primary px-5 py-3 rounded-pill fw-bold shadow" onclick="addToCartAndCheckout(${JSON.stringify(p).replace(/"/g, '&quot;')})">অর্ডার করুন</button>
                        <button class="btn btn-outline-primary px-4 py-3 rounded-pill fw-bold" onclick="CartManager.add(${JSON.stringify(p).replace(/"/g, '&quot;')})"><i class="fas fa-shopping-cart me-2"></i>কার্টে যোগ করুন</button>
                    </div>
                </div>
            </div>
        `);

        window.addToCartAndCheckout = function(product) {
            CartManager.add(product);
            window.location.href = '/Home/Checkout';
        };

        // AI Tracking: Track this view
        $.post('/api/products/track?productId=' + p.id + '&type=View');
    }).fail(function() {
        $('#productDetailContainer').html('<div class="alert alert-danger">Product not found.</div>');
    });
});
</script>
}
