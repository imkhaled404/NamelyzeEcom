@{
    ViewData["Title"] = "Customer Report";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <h3 class="fw-bold mb-0">Customer Analytics</h3>
    <p class="text-muted small">Tracking customer growth and behavior.</p>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="table-responsive">
        <table class="table table-hover small">
            <thead><tr class="text-muted"><th>Metric</th><th>Count</th><th>Growth</th></tr></thead>
            <tbody>
                <tr><td>New Customers (This Month)</td><td>120</td><td><span class="text-success">+15%</span></td></tr>
                <tr><td>Returning Customers</td><td>85</td><td><span class="text-success">+5%</span></td></tr>
            </tbody>
        </table>
    </div>
</div>
