@{
    ViewData["Title"] = "Sales Report";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Sales Reports</h3>
        <p class="text-muted small">Analyze revenue trends and order performance.</p>
    </div>
    <div class="d-flex gap-2">
        <input type="date" class="form-control form-control-sm">
        <button class="btn btn-primary btn-sm px-3 shadow-sm"><i class="fas fa-filter me-2"></i>Generate</button>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
            <h6 class="text-muted small text-uppercase fw-bold mb-2">Total Revenue</h6>
            <h2 class="fw-bold text-primary mb-0">৳ 12,45,000</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
            <h6 class="text-muted small text-uppercase fw-bold mb-2">Total Orders</h6>
            <h2 class="fw-bold text-success mb-0">1,250</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
            <h6 class="text-muted small text-uppercase fw-bold mb-2">AOV (Avg Order Value)</h6>
            <h2 class="fw-bold text-info mb-0">৳ 996</h2>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <h6 class="fw-bold mb-4">Sales Performance Grid</h6>
    <div class="table-responsive">
        <table class="table table-hover small">
            <thead><tr class="text-muted"><th>Date</th><th>Orders</th><th>Revenue</th><th>Profit</th></tr></thead>
            <tbody>
                <tr><td>01 Jun 2026</td><td>45</td><td>৳ 45,000</td><td>৳ 12,000</td></tr>
                <tr><td>02 Jun 2026</td><td>32</td><td>৳ 32,000</td><td>৳ 8,500</td></tr>
            </tbody>
        </table>
    </div>
</div>
