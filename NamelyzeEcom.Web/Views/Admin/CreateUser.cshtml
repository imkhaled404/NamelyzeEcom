@model NamelyzeEcom.Business.DTOs.RegisterUserDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create New User";
    var roles = ViewBag.Roles as IEnumerable<NamelyzeEcom.Business.DTOs.RoleDto>;
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card bg-glass border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-transparent border-bottom border-light p-4">
                    <h2 class="text-white mb-0 fw-bold">Create System User</h2>
                    <p class="text-light mb-0 opacity-75">Register a new administrative or customer user.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateUser" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-white">First Name</label>
                                <input asp-for="FirstName" class="form-control bg-white bg-opacity-10 border-light border-opacity-25 text-white" placeholder="First Name">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white">Last Name</label>
                                <input asp-for="LastName" class="form-control bg-white bg-opacity-10 border-light border-opacity-25 text-white" placeholder="Last Name">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white">Email Address</label>
                                <input asp-for="Email" type="email" class="form-control bg-white bg-opacity-10 border-light border-opacity-25 text-white" placeholder="Email Address">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control bg-white bg-opacity-10 border-light border-opacity-25 text-white" placeholder="Phone Number">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white">Assign Role</label>
                                <select name="roleId" class="form-select bg-white bg-opacity-10 border-light border-opacity-25 text-white">
                                    @if(roles != null) {
                                        foreach(var role in roles) {
                                            <option value="@role.Id" style="background:#222;">@role.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white">Password</label>
                                <input asp-for="Password" type="password" class="form-control bg-white bg-opacity-10 border-light border-opacity-25 text-white" placeholder="Password">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white">Confirm Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control bg-white bg-opacity-10 border-light border-opacity-25 text-white" placeholder="Confirm Password">
                            </div>
                        </div>

                        <div class="mt-4 pt-3">
                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill fw-bold">Create User Account</button>
                            <a asp-action="Users" class="btn btn-link text-white text-decoration-none ms-3">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-glass {
        background: rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>
