@{
    ViewData["Title"] = "Flash Sale Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Flash Sales</h3>
        <p class="text-muted small">Time-limited mega discount campaigns.</p>
    </div>
    <button class="btn btn-primary shadow-sm btn-sm px-3"><i class="fas fa-bolt me-2"></i>Setup Campaign</button>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1">Eid Mega Sale 2026</h5>
            <p class="text-muted small mb-0"><i class="far fa-calendar-alt me-1"></i>01 Jun - 15 Jun</p>
        </div>
        <span class="badge bg-success shadow-none">Active Now</span>
    </div>
    <hr class="my-4">
    <div class="table-responsive">
        <table class="table table-sm align-middle small">
            <thead><tr><th>Product</th><th>Regular</th><th>Flash Price</th><th>Stock</th></tr></thead>
            <tbody>
                <tr>
                    <td>Cotton Panjabi</td>
                    <td>৳ 1,500</td>
                    <td class="text-danger fw-bold">৳ 999</td>
                    <td>50 / 100</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
