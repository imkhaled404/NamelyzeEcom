@{
    ViewData["Title"] = "Product Report";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <h3 class="fw-bold mb-0">Product Performance</h3>
    <p class="text-muted small">Insights into product sales and engagement.</p>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="table-responsive">
        <table class="table table-hover small">
            <thead><tr class="text-muted"><th>Product</th><th>Views</th><th>Orders</th><th>Conversion</th></tr></thead>
            <tbody>
                <tr><td>Cotton Panjabi</td><td>12,500</td><td>450</td><td>3.6%</td></tr>
                <tr><td>Electric Grinder</td><td>8,200</td><td>320</td><td>3.9%</td></tr>
            </tbody>
        </table>
    </div>
</div>
