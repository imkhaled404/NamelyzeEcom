@{
    ViewData["Title"] = "Brand Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Brands</h3>
        <p class="text-muted small">Manage product brands and their visibility.</p>
    </div>
    <button class="btn btn-primary shadow-sm btn-sm px-3" data-bs-toggle="modal" data-bs-target="#addBrandModal"><i class="fas fa-plus me-2"></i>Add Brand</button>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small text-uppercase">
                <tr>
                    <th class="ps-4">Logo</th>
                    <th>Brand Name</th>
                    <th>Product Count</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody class="small">
                <tr>
                    <td class="ps-4">
                        <div class="bg-light rounded p-2 d-inline-block border" style="width: 50px; height: 50px;">
                            <img src="/images/brands/samsung.png" class="img-fluid" style="object-fit: contain;">
                        </div>
                    </td>
                    <td class="fw-bold">Samsung</td>
                    <td>15 Products</td>
                    <td>
                        <div class="form-check form-switch p-0 d-flex justify-content-center">
                            <input class="form-check-input ms-0" type="checkbox" checked>
                        </div>
                    </td>
                    <td class="text-end pe-4">
                        <div class="btn-group shadow-none">
                            <button class="btn btn-sm btn-light border"><i class="fas fa-edit text-info"></i></button>
                            <button class="btn btn-sm btn-light border"><i class="fas fa-trash text-danger"></i></button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Add Brand Modal -->
<div class="modal fade" id="addBrandModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom p-4">
                <h5 class="modal-title fw-bold">Add New Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="brandForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Brand Name</label>
                        <input type="text" class="form-control" name="Name" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Brand Logo</label>
                        <input type="file" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="brandStatus" checked>
                        <label class="form-check-label" for="brandStatus">Active Status</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top p-4">
                <button type="button" class="btn btn-light border px-4" data-bs-dismiss="modal">Close</button>
                <button type="submit" form="brandForm" class="btn btn-primary px-4 shadow">Save Brand</button>
            </div>
        </div>
    </div>
</div>
