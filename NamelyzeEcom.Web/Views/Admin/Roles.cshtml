@{
    ViewData["Title"] = "Role Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Roles</h3>
        <p class="text-muted small">Define administrative job functions.</p>
    </div>
    <button class="btn btn-primary shadow-sm btn-sm px-3"><i class="fas fa-plus me-2"></i>Add Role</button>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100">
            <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3 mx-auto" style="width: 60px; height: 60px;">
                <i class="fas fa-user-shield fs-4"></i>
            </div>
            <h6 class="fw-bold mb-1">Super Admin</h6>
            <p class="text-muted small mb-3">Full System Access</p>
            <a href="/Admin/Permissions" class="btn btn-sm btn-outline-danger w-100">Edit Permissions</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100">
            <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3 mx-auto" style="width: 60px; height: 60px;">
                <i class="fas fa-user-cog fs-4"></i>
            </div>
            <h6 class="fw-bold mb-1">Manager</h6>
            <p class="text-muted small mb-3">Inventory & Products</p>
            <a href="/Admin/Permissions" class="btn btn-sm btn-outline-primary w-100">Edit Permissions</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100">
            <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3 mx-auto" style="width: 60px; height: 60px;">
                <i class="fas fa-headset fs-4"></i>
            </div>
            <h6 class="fw-bold mb-1">Support</h6>
            <p class="text-muted small mb-3">Orders & Customers</p>
            <a href="/Admin/Permissions" class="btn btn-sm btn-outline-success w-100">Edit Permissions</a>
        </div>
    </div>
</div>
