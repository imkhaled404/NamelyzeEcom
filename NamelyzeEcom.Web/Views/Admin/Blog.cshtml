@{
    ViewData["Title"] = "Blog Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Blogs</h3>
        <p class="text-muted small">Manage content marketing and articles.</p>
    </div>
    <button class="btn btn-primary shadow-sm btn-sm px-3"><i class="fas fa-plus me-2"></i>New Article</button>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small text-uppercase">
                <tr>
                    <th class="ps-4">Title</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody class="small">
                <tr>
                    <td class="ps-4">
                        <span class="fw-bold">How to Choose the Best Panjabi</span>
                    </td>
                    <td>Fashion</td>
                    <td>01 Jun 2026</td>
                    <td><span class="badge bg-success-subtle text-success">Published</span></td>
                    <td class="text-end pe-4">
                        <button class="btn btn-sm btn-light border"><i class="fas fa-edit"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
