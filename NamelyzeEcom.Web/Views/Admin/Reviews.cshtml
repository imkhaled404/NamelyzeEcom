@{
    ViewData["Title"] = "Product Reviews";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Reviews</h3>
        <p class="text-muted small">Moderate customer feedback and ratings.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small text-uppercase">
                <tr>
                    <th class="ps-4">Product</th>
                    <th>Customer</th>
                    <th>Rating</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody class="small">
                <tr>
                    <td class="ps-4">
                        <span class="fw-medium">Cotton Panjabi</span>
                    </td>
                    <td>Imran Ahmed</td>
                    <td>
                        <div class="text-warning">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star text-muted"></i>
                        </div>
                    </td>
                    <td><span class="badge bg-warning-subtle text-warning">Pending</span></td>
                    <td class="text-end pe-4">
                        <button class="btn btn-sm btn-success shadow-none me-1"><i class="fas fa-check"></i></button>
                        <button class="btn btn-sm btn-danger shadow-none"><i class="fas fa-times"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
