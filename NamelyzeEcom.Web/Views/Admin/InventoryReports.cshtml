@{
    ViewData["Title"] = "Inventory Report";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <h3 class="fw-bold mb-0">Inventory Reports</h3>
    <p class="text-muted small">Tracking stock value and movement trends.</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted small fw-bold mb-1">Total Stock Value</h6>
            <h4 class="fw-bold mb-0">৳ 18,50,000</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 border-start border-danger border-4">
            <h6 class="text-muted small fw-bold mb-1">Low Stock Items</h6>
            <h4 class="fw-bold mb-0 text-danger">12</h4>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <h6 class="fw-bold mb-4">Fast Moving Products</h6>
    <div class="table-responsive">
        <table class="table table-hover small">
            <thead><tr class="text-muted"><th>Product</th><th>Sold (30 Days)</th><th>Trend</th></tr></thead>
            <tbody>
                <tr><td>Cotton Panjabi</td><td>450</td><td><span class="text-success"><i class="fas fa-chart-line me-1"></i>High</span></td></tr>
                <tr><td>Electric Grinder</td><td>320</td><td><span class="text-info"><i class="fas fa-chart-line me-1"></i>Steady</span></td></tr>
            </tbody>
        </table>
    </div>
</div>
