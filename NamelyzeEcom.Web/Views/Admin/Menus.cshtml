@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Menu Configuration";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card bg-glass border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-transparent border-bottom border-light p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="text-white mb-0 fw-bold">Dynamic Menus</h2>
                        <p class="text-light mb-0 opacity-75">Configure categories for the administrative sidebar</p>
                    </div>
                    <button class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addMenuModal">
                        <i class="bi bi-plus-lg me-2"></i>Add Menu Item
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-dark table-borderless align-middle mb-0">
                            <thead class="bg-white bg-opacity-10">
                                <tr>
                                    <th class="px-4 py-3 text-uppercase fs-xs tracking-wider opacity-50">Menu Title</th>
                                    <th class="px-4 py-3 text-uppercase fs-xs tracking-wider opacity-50">URL Path</th>
                                    <th class="px-4 py-3 text-uppercase fs-xs tracking-wider opacity-50">Icon</th>
                                    <th class="px-4 py-3 text-uppercase fs-xs tracking-wider opacity-50">Order</th>
                                    <th class="px-4 py-3 text-uppercase fs-xs tracking-wider opacity-50 text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="px-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <span class="fw-semibold">Dashboard</span>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3"><code class="text-info bg-info bg-opacity-10 px-2 py-1 rounded">/Admin/Index</code></td>
                                    <td class="px-4 py-3"><i class="bi bi-speedometer2 text-white"></i></td>
                                    <td class="px-4 py-3">1</td>
                                    <td class="px-4 py-3 text-end">
                                        <button class="btn btn-link text-info p-0 me-3" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        <button class="btn btn-link text-danger p-0" title="Delete"><i class="bi bi-trash3"></i></button>
                                    </td>
                                </tr>
                                <!-- More menus will be populated here dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-glass {
        background: rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .fs-xs { font-size: 0.75rem; }
    .tracking-wider { letter-spacing: 0.05em; }
    
    .table-hover tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.03) !important;
        transition: all 0.3s ease;
    }
</style>
