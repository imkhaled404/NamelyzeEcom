@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">User Management</h3>
        <p class="text-muted small">Manage administrative staff and customer accounts.</p>
    </div>
    <a href="/Admin/Users/Create" class="btn btn-primary shadow-sm btn-sm px-3"><i class="fas fa-plus me-2"></i>Add Staff Member</a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white p-4 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">All Users</h5>
        <div class="d-flex gap-2">
            <input type="text" class="form-control form-control-sm" placeholder="Search users...", style="width: 250px;">
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small text-uppercase">
                <tr>
                    <th class="ps-4">User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody class="small">
                <tr>
                    <td class="ps-4">
                        <div class="d-flex align-items-center">
                            <div class="avatar bg-primary text-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">A</div>
                            <div>
                                <div class="fw-bold">Admin User</div>
                                <div class="text-muted" style="font-size: 11px;">System Admin</div>
                            </div>
                        </div>
                    </td>
                    <td>admin@namelyze.com</td>
                    <td><span class="badge bg-danger">Super Admin</span></td>
                    <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    <td>01 Jun 2026</td>
                    <td class="text-end pe-4">
                        <button class="btn btn-sm btn-light border"><i class="fas fa-key text-warning"></i></button>
                        <button class="btn btn-sm btn-light border"><i class="fas fa-edit text-info"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
