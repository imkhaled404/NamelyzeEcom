    <script>
        $(document).ready(function () {

            // ---- Scroll to top ----
            $(window).scroll(function () {
                if ($(this).scrollTop() > 300) $('#scrollTop').fadeIn();
                else $('#scrollTop').fadeOut();
            });
            $('#scrollTop').click(function () { $('html,body').animate({ scrollTop: 0 }, 500); });

            // ---- Load categories from API ----
            NamelyzeEcom.ajax('/api/categories', 'GET', null, function (res) {
                var data = res.data || res;
                if (!data || !data.length) return;
                var sidebar = $('#sidebarCats');
                sidebar.empty();
                var catGrid = $('#catGrid');
                catGrid.empty();
                data.slice(0, 8).forEach(function (cat) {
                    sidebar.append(`
                <li><a href="/category.html?id=${cat.id}">
                    <span>${cat.name}</span><i class="fas fa-chevron-right"></i>
                </a></li>`);
                });
                data.slice(0, 6).forEach(function (cat) {
                    catGrid.append(`
                <div class="col"><div class="cat-card" onclick="window.location='/category.html?id=${cat.id}'">
                    <img src="${cat.image || 'https://placehold.co/70x70/FFF3EE/FE5200?text=📦'}" alt="${cat.name}">
                    <h6>${cat.name}</h6>
                </div></div>`);
                });
            });

            // ---- Direct order ----
            function directOrder(productId) {
                window.location.href = '/checkout.html?productId=' + productId;
            }

            // ---- Load products from API ----
            function buildProductCard(product) {
                var discount = product.regularPrice > product.salePrice
                    ? Math.round((product.regularPrice - product.salePrice) / product.regularPrice * 100)
                    : 0;
                var img = product.imageUrl || ('https://placehold.co/400x400/FFF3EE/FE5200?text=' + encodeURIComponent(product.name || 'Product'));
                return `
        <div class="col">
            <div class="product-card">
                ${discount > 0 ? `<div class="discount-badge">${discount}% ছাড়</div>` : ''}
                <button class="wish-btn" onclick="event.stopPropagation();" title="উইশলিস্ট"><i class="far fa-heart"></i></button>
                <div class="img-wrap">
                    <img src="${img}" alt="${product.name}" loading="lazy" onerror="this.src='https://placehold.co/400x400/f5f5f5/ccc?text=Product'">
                </div>
                <div class="card-body">
                    <div class="product-name">${product.name}</div>
                    <div class="price-box">
                        <span class="price-sale">৳ ${Number(product.salePrice).toLocaleString()}</span>
                        ${discount > 0 ? `<span class="price-regular">৳ ${Number(product.regularPrice).toLocaleString()}</span>` : ''}
                    </div>
                    <button class="btn-order" onclick="directOrder(${product.id})">
                        <i class="fas fa-shopping-bag me-2"></i>অর্ডার করুন
                    </button>
                </div>
            </div>
        </div>`;
            }

            // Load products
            $('#mainProductFeed').empty();
            NamelyzeEcom.ajax('/api/products?pageNumber=1&pageSize=16', 'GET', null,
                function (res) {
                    var data = res.data || res;
                    var container = $('#mainProductFeed');
                    container.empty();
                    if (!data || !data.length) {
                        // Show demo products when API returns nothing
                        loadDemoProducts(container);
                        return;
                    }
                    data.forEach(function (product) {
                        container.append(buildProductCard(product));
                    });
                },
                function () {
                    // On error, show demo products
                    loadDemoProducts($('#mainProductFeed'));
                }
            );

            function loadDemoProducts(container) {
                container.empty();
                var demos = [
                    { id: 1, name: 'প্রিমিয়াম ফ্রাইং প্যান নন-স্টিক', regularPrice: 1200, salePrice: 850, imageUrl: 'https://placehold.co/400x400/FFF3EE/FE5200?text=🍳' },
                    { id: 2, name: 'ডিজিটাল ব্লাড প্রেসার মনিটর', regularPrice: 2500, salePrice: 1800, imageUrl: 'https://placehold.co/400x400/FFF3EE/FE5200?text=💊' },
                    { id: 3, name: 'মাল্টি ফাংশনাল কিচেন ছুরি সেট', regularPrice: 800, salePrice: 600, imageUrl: 'https://placehold.co/400x400/FFF3EE/FE5200?text=🔪' },
                    { id: 4, name: 'USB চার্জিং হাব ৪ পোর্ট', regularPrice: 900, salePrice: 700, imageUrl: 'https://placehold.co/400x400/FFF3EE/FE5200?text=🔌' },
                    { id: 5, name: 'স্মার্ট ওয়্যারলেস ইয়ারবাড', regularPrice: 3500, salePrice: 2200, imageUrl: 'https://placehold.co/400x400/FFF3EE/FE5200?text=🎧' },
                    { id: 6, name: 'পোর্টেবল মিনি ফ্যান', regularPrice: 650, salePrice: 450, imageUrl: 'https://placehold.co/400x400/FFF3EE/FE5200?text=🌀' },
                    { id: 7, name: 'স্টেইনলেস স্টিল বাটি সেট', regularPrice: 1100, salePrice: 780, imageUrl: 'https://placehold.co/400x400/FFF3EE/FE5200?text=🥣' },
                    { id: 8, name: 'ওয়াটারপ্রুফ স্মার্টওয়াচ', regularPrice: 4500, salePrice: 3200, imageUrl: 'https://placehold.co/400x400/FFF3EE/FE5200?text=⌚' },
                ];
                demos.forEach(function (p) { container.append(buildProductCard(p)); });
            }

            // ---- Search ----
            $('#searchBtn').click(function () {
                var q = $('#searchInput').val().trim();
                if (q) window.location.href = '/search.html?q=' + encodeURIComponent(q);
            });
            $('#searchInput').keypress(function (e) {
                if (e.which === 13) $('#searchBtn').click();
            });

        });
    </script>
</body>

</html>